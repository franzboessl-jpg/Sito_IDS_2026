---
// Animazione originale I.D.S. del principio MicroTrack (pianta dall'alto + segnale per sottocella).
// Sequenza di 15 s: campo attivo → un animale attraversa (sotto soglia) → una persona attraversa
// (sopra soglia) → allarme localizzato in metri. Pulsanti per i passi e pausa (WCAG 2.2.2);
// con "riduci animazioni" parte ferma sul passo dell'allarme.
// Valori didattici coerenti con la scheda tecnica: sottocelle di 2 m (60 sottocelle = 120 m di perimetro).
// Soglia di allarme per sottocella: non è una retta, perché dipende dalla trasmissività del terreno
// in quel tratto (la taratura con la camminata di calibrazione la fissa sottocella per sottocella).
const N = 60, X0 = 60, LARGH = 780, BASE = 590, ALT = 120;
const soglie = Array.from({ length: N }, (_, i) =>
  +(0.55 + 0.12 * Math.sin(i * 0.33) + 0.07 * Math.sin(i * 1.1 + 1.3) + 0.03 * Math.sin(i * 2.7)).toFixed(3));
const w = LARGH / N;
const pathSoglia = soglie.map((v, i) => `${i === 0 ? 'M' : 'H'}${X0 + i * w} ${i === 0 ? '' : 'V'}${(BASE - v * ALT).toFixed(1)}`).join(' ')
  .replace(/^M(\S+) V/, 'M$1 ') + ` H${X0 + LARGH}`;
const yEtichetta = BASE - Math.max(...soglie.slice(36)) * ALT - 8;
// Telecamere PTZ: una sullo stabile, due su pali lungo il perimetro. A riposo sono ferme
// in panoramica grandangolare; all'allarme si posizionano tutte e tre sull'intruso.
const telecamere = [
  { x: 382, y: 217, riposo: -135, etx: -14, ety: 26 },
  { x: 726, y: 124, riposo: 150, etx: -6, ety: 30 },
  { x: 174, y: 376, riposo: -40, etx: 34, ety: 6 },
];
const passi = [
  { t: 0, fermo: 0, titolo: 'Campo attivo' },
  { t: 1, fermo: 3, titolo: 'Passa un animale' },
  { t: 5.6, fermo: 7.3, titolo: 'Passa una persona' },
  { t: 9.5, fermo: 10, titolo: 'Allarme localizzato' },
];
---
<figure class="animazione" data-mt-anim data-soglie={JSON.stringify(soglie)}>
  <div class="comandi" role="group" aria-label="Passi dell'animazione">
    {passi.map((p, i) => (
      <button type="button" data-vai={p.t} data-fermo={p.fermo} aria-pressed={i === 0 ? 'true' : 'false'}><span class="n">{i + 1}</span> {p.titolo}</button>
    ))}
    <button type="button" class="pausa" data-pausa aria-label="Metti in pausa l'animazione">❚❚</button>
  </div>

  <div class="scorri"><svg viewBox="0 0 900 640" role="img" aria-labelledby="mt-anim-titolo mt-anim-desc">
    <title id="mt-anim-titolo">Come MicroTrack distingue un animale da una persona</title>
    <desc id="mt-anim-desc">Pianta dall'alto di uno stabile con il campo di rilevazione lungo tutto il perimetro, diviso in sottocelle da 2 metri. Sotto, il grafico del segnale di ogni sottocella con la soglia di allarme di ogni tratto, che varia con il terreno. Un gatto attraversa il perimetro: il segnale resta sotto la soglia e non scatta nulla. Poi una persona attraversa: il segnale supera la soglia, scatta l'allarme, il sistema indica il punto esatto in metri e fino a tre telecamere PTZ, ferme in panoramica, si posizionano insieme sull'intruso.</desc>

    <!-- Legenda -->
    <g class="legenda" transform="translate(40 30)">
      <rect x="0" y="-11" width="30" height="14" rx="3" fill="#4A90D9" fill-opacity=".45" />
      <text x="38" y="0">campo di rilevazione</text>
      <line x1="210" y1="-4" x2="240" y2="-4" stroke="#E24C3B" stroke-width="3" />
      <text x="248" y="0">cavi interrati</text>
      <rect x="380" y="-11" width="3" height="14" fill="#fff" fill-opacity=".7" />
      <text x="391" y="0">divisione tra sottocelle (2 m)</text>
      <circle cx="660" cy="-4" r="7" fill="#0A1A2E" stroke="#E3ECF4" stroke-width="2.5" />
      <text x="674" y="0">telecamere PTZ</text>
    </g>

    <!-- Pianta -->
    <rect x="20" y="50" width="860" height="400" rx="16" fill="#0E2240" stroke="#3A6A93" />
    <rect x="110" y="70" width="680" height="360" rx="56" fill="#17392B" />
    <!-- alberi -->
    <g fill="#1F4D38" stroke="#2C6A4C" stroke-width="2">
      <circle cx="215" cy="190" r="26" /><circle cx="250" cy="335" r="20" /><circle cx="690" cy="345" r="24" />
    </g>
    <!-- stabile (ridotto) -->
    <g>
      <rect x="380" y="215" width="160" height="96" rx="5" fill="#2A3F55" stroke="#8FB0CC" stroke-width="2" />
      <path d="M380 215 L460 263 L540 215 M380 311 L460 263 L540 311" stroke="#8FB0CC" stroke-width="1.5" fill="none" opacity=".6" />
      <text x="460" y="334" text-anchor="middle" class="et piccolo forte">STABILE</text>
    </g>
    <!-- processore -->
    <line x1="540" y1="290" x2="750" y2="290" stroke="#8FB0CC" stroke-width="2" stroke-dasharray="6 5" />
    <rect x="604" y="273" width="56" height="34" rx="4" fill="#0A1A2E" stroke="#8FB0CC" stroke-width="2" />
    <text x="632" y="295" text-anchor="middle" class="et piccolo">MTP</text>
    <text x="632" y="326" text-anchor="middle" class="et piccolo">processore</text>

    <!-- telecamere PTZ: ferme in panoramica (grandangolo); all'allarme fino a 3 si posizionano sull'intruso -->
    {telecamere.map((c, i) => (
      <g transform={`translate(${c.x} ${c.y})`}>
        <path fill="url(#mt-cono)" data-cono={i} />
        <g data-ptz={i} transform={`rotate(${c.riposo})`}>
          <rect x="-4" y="-6" width="22" height="12" rx="3" fill="#E3ECF4" />
          <rect x="16" y="-4.5" width="5" height="9" rx="1.5" fill="#0A1A2E" />
        </g>
        <circle r="7.5" fill="#0A1A2E" stroke="#E3ECF4" stroke-width="2.5" />
        <text x={c.etx} y={c.ety} text-anchor="middle" class="et piccolo">{`PTZ ${i + 1}`}</text>
      </g>
    ))}
    <defs>
      <radialGradient id="mt-cono" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="scale(160)">
        <stop offset="0" stop-color="#FFE08A" stop-opacity=".45" /><stop offset="1" stop-color="#FFE08A" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="mt-cono-allarme" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="scale(380)">
        <stop offset="0" stop-color="#FF7B6B" stop-opacity=".6" /><stop offset="1" stop-color="#FF7B6B" stop-opacity=".05" />
      </radialGradient>
    </defs>
    <defs><path id="mt-percorso" data-percorso d="M190 100 H710 A40 40 0 0 1 750 140 V360 A40 40 0 0 1 710 400 H190 A40 40 0 0 1 150 360 V140 A40 40 0 0 1 190 100 Z" /></defs>
    <use href="#mt-percorso" fill="none" stroke="#4A90D9" stroke-opacity=".38" stroke-width="34" />
    <use href="#mt-percorso" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="34" data-celle />
    <use href="#mt-percorso" fill="none" stroke="#E8A33D" stroke-width="36" stroke-opacity="0" data-evid-animale />
    <use href="#mt-percorso" fill="none" stroke="#E24C3B" stroke-width="40" stroke-opacity="0" data-evid-persona />
    <use href="#mt-percorso" fill="none" stroke="#E24C3B" stroke-width="3" />

    <!-- gatto (vista dall'alto) -->
    <g data-gatto opacity="0">
      <ellipse cx="0" cy="0" rx="11" ry="5" fill="#D9D2C5" />
      <circle cx="12" cy="0" r="4.5" fill="#D9D2C5" />
      <path d="M-11 0 q-8 -2 -12 -9" stroke="#D9D2C5" stroke-width="2.5" fill="none" stroke-linecap="round" />
    </g>
    <!-- persona (vista dall'alto) -->
    <g data-persona opacity="0">
      <ellipse cx="0" cy="0" rx="15" ry="8" fill="#F4F7FA" />
      <circle cx="0" cy="1" r="7" fill="#C9D6E2" stroke="#F4F7FA" stroke-width="2" />
    </g>

    <!-- etichetta "nessun allarme" al passaggio dell'animale -->
    <g data-no-allarme opacity="0" transform="translate(150 300)">
      <rect x="24" y="-17" width="186" height="30" rx="6" fill="#E8A33D" />
      <text x="117" y="3" text-anchor="middle" class="et forte scuro">NESSUN ALLARME</text>
    </g>

    <!-- segnaposto dell'allarme -->
    <g data-allarme opacity="0">
      <circle r="22" fill="none" stroke="#E24C3B" stroke-width="3" data-onda />
      <g data-etichetta>
        <rect x="-226" y="24" width="192" height="30" rx="6" fill="#E24C3B" />
        <text x="-130" y="44" text-anchor="middle" class="et forte" data-testo-allarme>ALLARME · 0 m</text>
      </g>
    </g>

    <!-- Grafico del segnale per sottocella -->
    <g class="grafico">
      <text x="30" y="535" transform="rotate(-90 30 535)" text-anchor="middle" class="et piccolo">segnale (dB)</text>
      <line x1="60" y1="590" x2="840" y2="590" stroke="#8FB0CC" stroke-width="1.5" />
      <line x1="60" y1="470" x2="60" y2="590" stroke="#8FB0CC" stroke-width="1.5" />
      <g data-barre></g>
      <path d={pathSoglia} fill="none" stroke="#E24C3B" stroke-width="2.5" stroke-linejoin="round" />
      <text x="836" y={yEtichetta} text-anchor="end" class="et piccolo rosso">soglia di allarme calibrata sul terreno</text>
      <g class="et piccolo" text-anchor="middle">
        <text x="60" y="608">0</text><text x="255" y="608">30</text><text x="450" y="608">60</text><text x="645" y="608">90</text><text x="840" y="608">120</text>
      </g>
      <text x="450" y="630" text-anchor="middle" class="et piccolo">posizione lungo il perimetro (m) · una barra per sottocella</text>
    </g>
  </svg></div>

  <p class="stato" data-stato>Campo attivo: il perimetro è sorvegliato, nessun segnale supera la soglia.</p>

</figure>

<script>
  const DURATA = 15, N = 60, METRI = 120;
  const PX = 290; // punto di ingresso della persona sul lato nord: visuale libera per tutte e tre le PTZ
  const X0 = 60, LARGH = 780, BASE = 590;

  document.querySelectorAll<HTMLElement>('[data-mt-anim]').forEach((box) => {
    const q = <T extends Element>(s: string) => box.querySelector(s) as T;
    const soglie: number[] = JSON.parse(box.dataset.soglie || '[]');
    const percorso = q<SVGPathElement>('[data-percorso]');
    const L = percorso.getTotalLength();
    const cella = L / N;
    q<SVGUseElement>('[data-celle]').setAttribute('stroke-dasharray', `2 ${cella - 2}`);

    // punto del percorso più vicino a (x, y) → ascissa curvilinea
    const ascissa = (x: number, y: number) => {
      let best = 0, dmin = Infinity;
      for (let s = 0; s < L; s += 2) {
        const p = percorso.getPointAtLength(s);
        const d = (p.x - x) ** 2 + (p.y - y) ** 2;
        if (d < dmin) { dmin = d; best = s; }
      }
      return best;
    };
    const sGatto = ascissa(150, 300), sPersona = ascissa(PX, 100);
    const iGatto = Math.floor(sGatto / cella), iPersona = Math.floor(sPersona / cella);
    const metriPersona = Math.round((iPersona + 0.5) * METRI / N);
    const pAllarme = percorso.getPointAtLength((iPersona + 0.5) * cella);

    const evid = (sel: string, i: number) => {
      const el = q<SVGUseElement>(sel);
      el.setAttribute('stroke-dasharray', `${cella} ${L}`);
      el.setAttribute('stroke-dashoffset', String(-i * cella));
      return el;
    };
    const evAnimale = evid('[data-evid-animale]', iGatto);
    const evPersona = evid('[data-evid-persona]', iPersona);

    // barre del grafico
    const gBarre = q<SVGGElement>('[data-barre]');
    const NS = 'http://www.w3.org/2000/svg';
    const barre = Array.from({ length: N }, (_, i) => {
      const r = document.createElementNS(NS, 'rect');
      r.setAttribute('x', String(X0 + i * (LARGH / N) + 2));
      r.setAttribute('width', String(LARGH / N - 4));
      r.setAttribute('rx', '1.5');
      gBarre.appendChild(r);
      return r;
    });
    const rumore = barre.map((_, i) => 0.5 + 0.5 * Math.sin(i * 1.7));

    const gatto = q<SVGGElement>('[data-gatto]'), persona = q<SVGGElement>('[data-persona]');
    const noAllarme = q<SVGGElement>('[data-no-allarme]');
    const allarme = q<SVGGElement>('[data-allarme]'), onda = q<SVGCircleElement>('[data-onda]');
    q<SVGTextElement>('[data-testo-allarme]').textContent = `ALLARME · ${metriPersona} m`;
    allarme.setAttribute('transform', `translate(${pAllarme.x} ${pAllarme.y})`);
    const CAM = [
      { x: 382, y: 217, riposo: -135 },
      { x: 726, y: 124, riposo: 150 },
      { x: 174, y: 376, riposo: -40 },
    ].map((c, i) => ({ ...c, testa: q<SVGGElement>(`[data-ptz="${i}"]`), cono: q<SVGPathElement>(`[data-cono="${i}"]`) }));
    const RAD = Math.PI / 180;
    const spicchio = (ang: number, semi: number, r: number) => {
      const a = (ang - semi) * RAD, b = (ang + semi) * RAD;
      return `M0 0 L${r * Math.cos(a)} ${r * Math.sin(a)} A${r} ${r} 0 0 1 ${r * Math.cos(b)} ${r * Math.sin(b)} Z`;
    };
    const vicino = (da: number, a: number) => { let d = ((a - da + 540) % 360) - 180; return da + d; };
    const liscio = (k: number) => k * k * (3 - 2 * k);
    const stato = q<HTMLElement>('[data-stato]');
    const pulsanti = [...box.querySelectorAll<HTMLButtonElement>('[data-vai]')];
    const pausa = q<HTMLButtonElement>('[data-pausa]');

    const fra = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
    const vicinanza = (d: number) => Math.max(0, 1 - Math.abs(d) / 34);

    const disegna = (t: number) => {
      // gatto: da fuori a dentro sul lato sinistro (t 1 → 5); rallenta mentre attraversa il campo
      const visGatto = t >= 1 && t < 5.3;
      const gx = t < 1.9 ? 70 + fra(t, 1, 1.9) * 52 : t < 4.2 ? 122 + fra(t, 1.9, 4.2) * 56 : 178 + fra(t, 4.2, 5) * 72;
      gatto.setAttribute('transform', `translate(${gx} 300)`);
      gatto.setAttribute('opacity', visGatto ? '1' : '0');
      const segGatto = visGatto ? vicinanza(gx - 150) : 0;

      // persona: da fuori a dentro sul lato nord (t 5.6 → 9.4), poi resta ferma
      const visPersona = t >= 5.6 && t < 14.4;
      const py = -20 + fra(t, 5.6, 9.4) * 185;
      persona.setAttribute('transform', `translate(${PX} ${py})`);
      persona.setAttribute('opacity', visPersona && py > 52 ? '1' : '0');
      const segPersona = visPersona && py > 52 ? vicinanza(py - 100) : 0;
      const inAllarme = t >= 7.8 && t < 14.4;

      // barre
      barre.forEach((b, i) => {
        let v = 0.12 + 0.08 * rumore[i] * (0.6 + 0.4 * Math.sin(t * 3 + i));
        let colore = '#4A90D9';
        if (i === iGatto) { v += (0.8 * soglie[i] - v) * segGatto; if (segGatto > 0.05) colore = '#E8A33D'; }
        if (Math.abs(i - iPersona) <= 1) {
          const k = i === iPersona ? 1.3 : 0.45;
          v += k * soglie[i] * segPersona;
          if (inAllarme && i === iPersona) { v = Math.max(v, soglie[i] + 0.12 + 0.04 * Math.sin(t * 6)); colore = '#E24C3B'; }
        }
        const h = Math.min(1, v) * 120;
        b.setAttribute('y', String(BASE - h));
        b.setAttribute('height', String(h));
        b.setAttribute('fill', colore);
      });

      evAnimale.setAttribute('stroke-opacity', String(0.75 * segGatto));
      evPersona.setAttribute('stroke-opacity', inAllarme ? String(0.65 + 0.3 * Math.sin(t * 6)) : '0');
      allarme.setAttribute('opacity', inAllarme ? '1' : '0');
      noAllarme.setAttribute('opacity', segGatto > 0.05 ? '1' : '0');
      // PTZ: a riposo panoramica larga; in allarme ruotano e stringono (zoom) sull'intruso, poi tornano
      CAM.forEach((c) => {
        const verso = (yy: number) => vicino(c.riposo, Math.atan2(yy - c.y, PX - c.x) / RAD);
        const dist = (yy: number) => Math.hypot(PX - c.x, yy - c.y);
        let k = 0, ang = c.riposo, r = 125;
        if (inAllarme) { k = liscio(fra(t, 7.8, 8.7)); ang = c.riposo + (verso(py) - c.riposo) * k; r = 125 + (dist(py) + 30 - 125) * k; }
        else if (t >= 14.4) { const tornata = liscio(fra(t, 14.4, 15)); k = 1 - tornata; ang = verso(165) + (c.riposo - verso(165)) * tornata; r = dist(165) + 30 + (125 - dist(165) - 30) * tornata; }
        const semi = 42 - 32 * k;
        c.testa.setAttribute('transform', `rotate(${ang})`);
        c.cono.setAttribute('d', spicchio(ang, semi, r));
        c.cono.setAttribute('fill', k > 0.5 ? 'url(#mt-cono-allarme)' : 'url(#mt-cono)');
      });
      const fase = (t * 0.9) % 1;
      onda.setAttribute('r', String(18 + fase * 26));
      onda.setAttribute('stroke-opacity', String(1 - fase));

      let testo = 'Campo attivo: il perimetro è sorvegliato, nessun segnale supera la soglia.';
      let passo = 0;
      if (t >= 1 && t < 5.6) { passo = 1; testo = 'Un piccolo animale attraversa: il segnale sale ma resta sotto la soglia di quel tratto, nessun allarme.'; }
      else if (t >= 5.6 && t < 7.8) { passo = 2; testo = 'Una persona si avvicina al perimetro…'; }
      else if (inAllarme) { passo = t < 9.5 ? 2 : 3; testo = `Allarme: il segnale supera la soglia di quel tratto. Intrusione localizzata a ${metriPersona} m lungo il perimetro: le telecamere PTZ (fino a 3 insieme) si posizionano sull’intruso e lo seguono.`; }
      if (stato.textContent !== testo) stato.textContent = testo;
      stato.classList.toggle('rosso', inAllarme);
      pulsanti.forEach((p, i) => p.setAttribute('aria-pressed', String(i === passo)));
    };

    let t = 0, inCorso = !window.matchMedia('(prefers-reduced-motion: reduce)').matches, ultimo = 0;
    if (!inCorso) t = 10;
    const aggiornaPausa = () => {
      pausa.textContent = inCorso ? '❚❚' : '▶';
      pausa.setAttribute('aria-label', inCorso ? 'Metti in pausa l’animazione' : 'Avvia l’animazione');
    };
    const ciclo = (ora: number) => {
      if (inCorso) { t = (t + Math.min(0.1, (ora - ultimo) / 1000)) % DURATA; disegna(t); }
      ultimo = ora;
      requestAnimationFrame(ciclo);
    };
    pulsanti.forEach((p) => p.addEventListener('click', () => {
      t = Number(inCorso ? p.dataset.vai : p.dataset.fermo);
      disegna(t);
    }));
    pausa.addEventListener('click', () => { inCorso = !inCorso; aggiornaPausa(); });
    aggiornaPausa();
    disegna(t);
    requestAnimationFrame((ora) => { ultimo = ora; requestAnimationFrame(ciclo); });
  });
</script>

<style>
  .animazione{margin:0;display:grid;gap:12px}
  .scorri{overflow-x:auto;border-radius:16px}
  @media (max-width:640px){ svg{min-width:640px} }
  svg{display:block;width:100%;height:auto;border-radius:16px;background:#0A1A2E;border:1px solid rgba(143,176,204,.45)}
  .legenda text,.et{font-family:var(--font-testo);font-size:17px;fill:#E3ECF4}
  .piccolo{font-size:15px}
  .forte{font-weight:700;fill:#fff}
  .rosso{fill:#FF7B6B}
  .scuro{fill:#0A1A2E}
  .stato{margin:0;min-height:3em;font-family:var(--font-testo);font-size:16px;line-height:1.5;color:var(--ghiaccio);border-left:4px solid var(--luminoso);padding:4px 0 4px 12px}
  .stato.rosso{border-color:#E24C3B;color:#fff}
  .comandi{display:flex;flex-wrap:wrap;gap:6px}
  button{display:inline-flex;align-items:center;gap:6px;padding:7px 11px;border-radius:999px;border:1px solid rgba(143,176,204,.55);background:transparent;color:var(--ghiaccio);font:600 14px var(--font-testo);cursor:pointer;transition:background .3s ease,border-color .3s ease}
  button:hover{border-color:var(--luminoso)}
  button[aria-pressed="true"]{background:var(--luminoso);border-color:var(--luminoso);color:#fff}
  .pausa{min-width:40px;justify-content:center;margin-left:auto}
  .n{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,.18);font-size:13px}
</style>
