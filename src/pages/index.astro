---
// Landing page – versione v3.4 approvata il 20/11/2026
import Base from '../layouts/Base.astro';
import { url } from '../site';
---
<Base
  title="I.D.S. Sicurezza – Ingegneria della sicurezza e integrazione dei sistemi"
  description="I.D.S. Sicurezza, Folignano (AP): antintrusione, videosorveglianza, antincendio, controllo accessi, domotica e cablaggio strutturato per casa, aziende, industria e difesa. Dal 1975."
  ogTitle="I.D.S. Sicurezza – Ogni esigenza di sicurezza merita la soluzione giusta"
>
<main class="page">

  <a class="logo" href={url('/')} aria-label="I.D.S. Sicurezza, pagina iniziale">
    <img src={url('/assets/logo-ids-bianco.png')} srcset={`${url('/assets/logo-ids-bianco.png')} 1x, ${url('/assets/logo-ids-bianco@2x.png')} 2x`} width="160" height="123" alt="I.D.S. Sicurezza">
  </a>

  <p class="eyebrow">Ingegneria della sicurezza e integrazione dei sistemi</p>

  <h1>Ogni esigenza di sicurezza merita la soluzione giusta.</h1>

  <section class="cards" aria-label="Aree principali">

    <a class="card" href={url('/casa/')}>
      <div class="photo"><img src={url('/assets/casa.webp')} alt="Villa contemporanea con ulivo e giardino illuminato all'imbrunire" width="1800" height="600"></div>
      <div class="band">
        <svg class="ico" viewBox="0 0 64 64" aria-hidden="true"><path d="M8 30 32 9l24 21M14 26v29h36V26M27 55V39h10v16"/></svg>
        <span class="sep" aria-hidden="true"></span>
        <div class="txt">
          <h2>Casa e attività</h2>
          <p>Soluzioni chiare, affidabili e su misura per abitazioni, negozi e uffici.</p>
        </div>
      </div>
    </a>

    <a class="card" href={url('/sistemi-avanzati/')}>
      <div class="photo"><img src={url('/assets/sistemi-avanzati.webp')} alt="Recinzione con sensore INTREPID e telecamera dome davanti a uno stabilimento industriale" width="1800" height="601"></div>
      <div class="band">
        <svg class="ico" viewBox="0 0 64 64" aria-hidden="true"><path d="M7 55V33l14 8v-8l14 8V14h9V8h7v47ZM7 55h50M15 47h5M27 47h5M39 47h5"/></svg>
        <span class="sep" aria-hidden="true"></span>
        <div class="txt">
          <h2>Sistemi avanzati</h2>
          <p>Infrastrutture, industria, difesa e protezioni specialistiche.</p>
        </div>
      </div>
    </a>

  </section>

  <nav aria-label="Le nostre attività">
    <ul class="services">
      <li><a href={url('/antintrusione/')}><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4 7 9v10c0 8.5 5.6 14.6 13 17 7.4-2.4 13-8.5 13-17V9Z"/><circle cx="20" cy="18" r="3.5"/><path d="M20 21.5V27"/></svg>Antintrusione</a></li>
      <li><a href={url('/videosorveglianza/')}><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M5 13 27 7l3 10-22 6ZM30 13l6-2v9l-6 1M14 22l2 7H6"/><path d="M6 25v8"/></svg>Videosorveglianza</a></li>
      <li><a href={url('/antincendio/')}><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 36c-6.6 0-11-4.4-11-10.5C9 18 16 15 17 6c5 3 14 10 14 19.5C31 31.6 26.6 36 20 36Z"/><path d="M20 36c-2.8 0-4.6-2-4.6-4.6 0-3.4 3-5 4.6-8.4 1.6 3.4 4.6 5 4.6 8.4 0 2.6-1.8 4.6-4.6 4.6Z"/></svg>Antincendio</a></li>
      <li><a href={url('/controllo-accessi/')}><svg viewBox="0 0 40 40" aria-hidden="true"><rect x="5" y="10" width="30" height="22" rx="3"/><path d="M16 6h8v6h-8ZM10 27c.8-3 2.6-4.5 5-4.5s4.2 1.5 5 4.5M23 18h8M23 23h6"/><circle cx="15" cy="18" r="3"/></svg>Controllo accessi</a></li>
      <li><a href={url('/domotica/')}><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M5 19 20 6l15 13M9 16v18h22V16"/><path d="M14.5 24.5a8 8 0 0 1 11 0M17 27.5a4 4 0 0 1 6 0"/><circle cx="20" cy="30.5" r=".8"/></svg>Domotica</a></li>
      <li><a href={url('/cablaggio-strutturato/')}><svg viewBox="0 0 40 40" aria-hidden="true"><rect x="15" y="4" width="10" height="9" rx="1.5"/><rect x="4" y="27" width="10" height="9" rx="1.5"/><rect x="26" y="27" width="10" height="9" rx="1.5"/><path d="M20 13v7M9 27v-7h22v7"/></svg>Cablaggio strutturato</a></li>
    </ul>
  </nav>

</main>
</Base>

<style>
.page{position:relative;width:min(1560px,95%);margin:0 auto;padding:22px 0 56px}

/* Intestazione */
.logo{display:block;width:max-content;margin:0 auto}
.logo img{display:block;height:112px;width:auto}
.eyebrow{
  display:flex;align-items:center;justify-content:center;gap:24px;margin:14px 0 0;
  font-size:clamp(10px,1.05vw,16px);font-weight:500;letter-spacing:.22em;text-transform:uppercase;text-align:center;color:var(--ghiaccio)
}
.eyebrow:before,.eyebrow:after{content:"";flex:1;max-width:170px;height:1px;background:var(--chiaro);opacity:.8}
h1{margin:14px 0 30px;text-align:center;font-size:clamp(23px,2.6vw,42px);font-weight:700;line-height:1.25;letter-spacing:-.015em;color:#fff}

/* Schede principali */
.cards{display:grid;grid-template-columns:1fr 1fr;gap:26px}
.card{
  display:flex;flex-direction:column;border-radius:18px;overflow:hidden;text-decoration:none;color:inherit;
  border:1px solid rgba(143,176,204,.55);background:linear-gradient(180deg,#123354 0%,#0E2744 100%);
  box-shadow:0 18px 45px rgba(4,14,28,.55),inset 0 1px 0 rgba(227,236,244,.08);
  transition:transform .45s ease,box-shadow .45s ease,border-color .45s ease
}
.card:hover,.card:focus-visible{transform:translateY(-5px);border-color:var(--luminoso);box-shadow:0 26px 60px rgba(4,14,28,.7),0 0 0 1px rgba(74,144,217,.35)}
.card:focus-visible{outline:2px solid var(--ghiaccio);outline-offset:4px}
.photo{position:relative;aspect-ratio:3/1.1;overflow:hidden}
.photo img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1s cubic-bezier(.2,.7,.2,1)}
.card:hover .photo img{transform:scale(1.035)}
.photo:after{ /* raccordo morbido tra foto e fascia */
  content:"";position:absolute;left:0;right:0;bottom:0;height:22%;
  background:linear-gradient(180deg,transparent,rgba(18,51,84,.85))
}
.band{flex:1;display:flex;align-items:stretch;gap:26px;padding:20px 40px 26px}
.band .txt{display:flex;flex-direction:column;align-items:flex-start;flex:1}
.band .ico{flex:none;align-self:flex-start;width:64px;height:64px;margin-top:4px;stroke:#fff;stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round}
.band .sep{flex:none;width:1px;align-self:flex-start;height:76px;max-height:76px;margin-top:4px;background:rgba(143,176,204,.55)}
.band h2{margin:0 0 8px;font-size:clamp(22px,2.15vw,36px);font-weight:700;line-height:1.15;color:#fff}
.band p{margin:0;font-size:clamp(14px,1.25vw,20px);line-height:1.45;color:var(--ghiaccio);max-width:520px}
/* Attività */
.services{list-style:none;margin:56px 0 0;padding:0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}
.services li{min-width:0}
.services a{
  display:flex;align-items:center;justify-content:center;gap:12px;height:70px;padding:0 14px;border-radius:16px;
  border:1px solid rgba(143,176,204,.6);background:rgba(14,39,68,.55);color:#fff;text-decoration:none;
  font-weight:600;font-size:clamp(13px,1vw,17px);line-height:1.2;text-align:left;
  box-shadow:inset 0 1px 0 rgba(227,236,244,.06);transition:border-color .3s ease,background .3s ease,transform .3s ease
}
.services a:hover,.services a:focus-visible{border-color:var(--luminoso);background:rgba(28,68,103,.75);transform:translateY(-2px)}
.services a:focus-visible{outline:2px solid var(--ghiaccio);outline-offset:3px}
.services svg{flex:none;width:32px;height:32px;stroke:#fff;stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round}

@media (max-width:1100px){
  .services{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media (max-width:900px){
  .cards{grid-template-columns:1fr;gap:20px}
}
@media (max-width:600px){
  .logo img{height:80px}
  .eyebrow{gap:10px;letter-spacing:.1em}
  .eyebrow:before,.eyebrow:after{max-width:28px}
  .band{gap:14px;padding:16px 18px 20px}
  .band .ico{width:44px;height:44px}
  .services{gap:10px;margin-top:36px}
  .services{grid-template-columns:repeat(2,minmax(0,1fr))}
  .services a{height:58px;padding:0 12px;gap:10px}
  .services svg{width:28px;height:28px}
}
</style>
