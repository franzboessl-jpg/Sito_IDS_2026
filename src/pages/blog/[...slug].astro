---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { articoli, dataIt } from '../../lib/blog';
import { url } from '../../site';

export async function getStaticPaths() {
  const lista = await articoli();
  return lista.map((a) => ({ params: { slug: a.id }, props: { articolo: a } }));
}
const { articolo } = Astro.props;
const d = articolo.data;
const { Content } = await render(articolo);
---
<Base title={`${d.titolo} | I.D.S. Sicurezza`} description={d.descrizione} image={d.immagine} type="article">
  <Header />
  <main class="wrap">
    <p class="torna"><a href={url('/blog/')}>← Tutti gli articoli</a></p>
    <article>
      <header>
        <p class="meta">{dataIt(d.data)} · {d.livello}{d.bozza && ' · BOZZA'}</p>
        <h1>{d.titolo}</h1>
        <p class="lead">{d.descrizione}</p>
      </header>
      {d.immagine && <img class="cover" src={url(d.immagine)} alt={d.immagineAlt ?? ''} />}
      <div class="testo"><Content /></div>
    </article>
  </main>
</Base>

<style>
  .wrap{position:relative;width:min(860px,92%);margin:0 auto;padding:28px 0 56px}
  .torna a{color:var(--chiaro);text-decoration:none;font-weight:600}
  .torna a:hover{color:#fff}
  article{margin-top:16px;border-radius:18px;background:var(--ghiaccio);color:var(--grafite);padding:clamp(22px,4vw,48px);box-shadow:0 18px 45px rgba(4,14,28,.55)}
  .meta{margin:0;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--acciaio)}
  h1{margin:8px 0 12px;font-size:clamp(30px,3.6vw,46px);line-height:1.15;color:var(--logo)}
  .lead{margin:0 0 24px;font-family:var(--font-testo);font-size:19px;line-height:1.6;color:var(--acciaio-scuro)}
  .cover{display:block;width:100%;height:auto;border-radius:12px;margin:0 0 24px}
  .testo{font-family:var(--font-testo);font-size:18px;line-height:1.6}
  .testo :global(h2){font-family:var(--font-titoli);font-size:clamp(24px,2.4vw,32px);color:var(--logo);margin:36px 0 12px}
  .testo :global(h3){font-family:var(--font-titoli);font-size:clamp(20px,1.9vw,24px);color:var(--acciaio-scuro);margin:28px 0 10px}
  .testo :global(a){color:#1F5FA8}
  .testo :global(img){max-width:100%;height:auto;border-radius:10px}
  .testo :global(table){border-collapse:collapse;width:100%;font-size:16px;margin:16px 0}
  .testo :global(th),.testo :global(td){border:1px solid #9DB3C8;padding:8px 10px;text-align:left}
  .testo :global(th){background:#CFDDEA}
  .testo :global(blockquote){margin:20px 0;padding:4px 18px;border-left:4px solid var(--acciaio);color:var(--acciaio-scuro)}
  @media (max-width:600px){.testo{font-size:17px}}
</style>
