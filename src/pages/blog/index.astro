---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { articoli, dataIt } from '../../lib/blog';
import { url } from '../../site';
const lista = await articoli();
---
<Base
  title="Blog e approfondimenti tecnici | I.D.S. Sicurezza"
  description="Articoli su antintrusione, videosorveglianza, protezioni perimetrali, antincendio e integrazione dei sistemi di sicurezza, da 50 anni di impianti realizzati."
>
  <Header />
  <main class="wrap">
    <h1>Blog e approfondimenti</h1>
    <p class="intro">Esperienza sul campo, norme e soluzioni: dalla casa ai siti critici.</p>
    {lista.length === 0 && <p class="vuoto">I primi articoli sono in arrivo.</p>}
    <ul class="lista">
      {lista.map((a) => (
        <li>
          <a href={url(`/blog/${a.id}/`)}>
            <span class="meta">{dataIt(a.data.data)} · {a.data.livello}{a.data.bozza && ' · BOZZA'}</span>
            <span class="titolo">{a.data.titolo}</span>
            <span class="desc">{a.data.descrizione}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .wrap{position:relative;width:min(960px,92%);margin:0 auto;padding:40px 0 56px}
  h1{margin:0 0 8px;font-size:clamp(32px,3.4vw,48px);color:#fff}
  .intro{margin:0 0 32px;font-family:var(--font-testo);font-size:18px;color:var(--chiaro)}
  .vuoto{font-family:var(--font-testo);color:var(--chiaro)}
  .lista{list-style:none;margin:0;padding:0;display:grid;gap:16px}
  .lista a{display:block;padding:22px 26px;border-radius:16px;border:1px solid rgba(143,176,204,.45);background:rgba(14,39,68,.55);text-decoration:none;transition:border-color .3s ease,transform .3s ease}
  .lista a:hover,.lista a:focus-visible{border-color:var(--luminoso);transform:translateY(-2px)}
  .meta{display:block;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--chiaro)}
  .titolo{display:block;margin:6px 0;font-size:clamp(20px,2vw,26px);font-weight:700;color:#fff}
  .desc{display:block;font-family:var(--font-testo);font-size:17px;line-height:1.6;color:var(--ghiaccio)}
</style>
